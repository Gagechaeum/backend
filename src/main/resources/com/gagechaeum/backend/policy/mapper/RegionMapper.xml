<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gagechaeum.backend.policy.mapper.RegionMapper">

    <select id="findAll" resultType="com.gagechaeum.backend.policy.domain.Region">
        SELECT
            region_id,
            super_id,
            depth,
            name,
            full_name
        FROM
            regions
    </select>

</mapper>