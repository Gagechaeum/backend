<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gagechaeum.backend.document.mapper.UserDocumentMapper">

  <insert id="insert" parameterType="com.gagechaeum.backend.document.domain.UserDocument"
    useGeneratedKeys="true" keyProperty="uploadedId">
    INSERT INTO user_documents (user_id, document_id, issued_at, file_url)
    VALUES (#{userId}, #{documentId}, #{issuedAt}, #{fileUrl})
  </insert>

</mapper>
