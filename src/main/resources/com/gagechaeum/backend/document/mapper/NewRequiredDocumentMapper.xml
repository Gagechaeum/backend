<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gagechaeum.backend.document.mapper.NewRequiredDocumentMapper">

    <insert id="save" parameterType="com.gagechaeum.backend.document.domain.NewRequiredDocument">
