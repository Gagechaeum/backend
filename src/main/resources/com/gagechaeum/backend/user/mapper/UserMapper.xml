<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gagechaeum.backend.user.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.gagechaeum.backend.user.domain.User">
        <id property="userId" column="user_id"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="nick" column="nickname"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="createdAt" column="created_at"/>
        <result property="social" column="social"/>
        <result property="socialId" column="social_id"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="isVerified" column="is_verified"/>
    </resultMap>

    <insert id="save" parameterType="com.gagechaeum.backend.user.domain.User"
            useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO users (email, password, nickname, name, phone, created_at, social, social_id, is_verified)
        VALUES (#{email}, #{password}, #{nick}, #{name}, #{phone}, NOW(), #{social}, #{socialId}, #{isVerified})
    </insert>

    <insert id="insertUserChallengeSummary" parameterType="long">
        INSERT INTO user_challenge_summary (user_id, created_at, updated_at)
        VALUES (#{userId}, NOW(), NOW())
    </insert>

    <update id="updatePassword" parameterType="com.gagechaeum.backend.user.domain.User">
        UPDATE users
        SET password = #{password},
        WHERE user_id = #{userId}
    </update>

    <update id="resetPassword" parameterType="com.gagechaeum.backend.user.domain.User">
        UPDATE users
        SET password = #{password},
        WHERE user_id = #{userId}
    </update>

    <update id="updateIsActive">
        UPDATE users
        SET deleted_at =
        <if test="isActive == true">
            NULL
        </if>
        <if test="isActive == false">
            NOW()
        </if>
        WHERE user_id = #{userId}
    </update>

    <update id="updateIsVerifiedByEmail">
        UPDATE users
        SET is_verified = #{isVerified}
        WHERE email = #{email}
    </update>

    <select id="findByEmail" parameterType="String" resultMap="userResultMap">
        SELECT *
        FROM users
        WHERE email = #{email}
          AND deleted_at IS NULL
    </select>

    <select id="findNicknameById" parameterType="long" resultType="java.lang.String">
        SELECT nickname
        FROM users
        WHERE user_id = #{userId}
    </select>

    <select id="selectIsVerifiedByEmail" parameterType="String" resultType="java.lang.Boolean">
        SELECT is_verified
        FROM users
        WHERE email = #{email}
    </select>

</mapper>